# Variables pour un deploiement DISTANT d'ai_service (serveur separe du
# backend, connecte via tunnel WireGuard prive — cf. ARCHITECTURE_IA.md
# section 1ter, mise a jour 2026-07-30 : ai_service ne partage plus le reseau
# Docker local du backend, il tourne sur son propre VPS).
#
# Contrairement a .env.ai.example (deploiement colocalise, meme serveur que
# stream_backend), ce fichier est AUTONOME : pas d'env_file pointant vers
# /opt/backend-stack/.env (qui n'existe pas sur ce serveur). Toutes les
# credentials sont ici, completes.
#
# Topologie reseau : tunnel WireGuard entre les deux VPS Contabo.
# - VPS backend (178.238.230.82) = peer WireGuard 10.10.0.1, expose
#   postgres:5432/redis:6379/rabbitmq:5672 UNIQUEMENT sur cette IP privee
#   (jamais sur 0.0.0.0 — verifie le 2026-07-30, ports absents en scan externe).
# - VPS ai_service (169.58.100.82) = peer WireGuard 10.10.0.2.
#
# Remplacer <PASSWORD> par les vraies valeurs (memes que /opt/backend-stack/.env
# sur l'autre serveur) UNIQUEMENT dans le fichier .env.ai reel sur CE serveur,
# jamais ici ni dans un commit.

# DSN direct asyncpg (PAS le format SQLAlchemy +asyncpg du backend, cf. note
# dans pgvector_store.py) — host = IP WireGuard du VPS backend.
DATABASE_URL=postgresql://stream:<PASSWORD>@10.10.0.1:5432/streaming

# DB 2 pour ne pas collisionner avec le cache/broker du backend (DB 0).
REDIS_URL=redis://:<PASSWORD>@10.10.0.1:6379/2

# vhost et credentials identiques au backend — host = IP WireGuard.
RABBITMQ_URL=amqp://stream:<PASSWORD>@10.10.0.1:5672/stream_vhost

TEXT_MODEL_PATH=./models/qwen3-1.7b-instruct-q4_k_m.gguf
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
YOLO_MODEL_PATH=./models/yolov11n.pt
WHISPER_MODEL_SIZE=base

MAX_RAM_MB_FOR_MODELS=2500
AI_QUEUE_CONCURRENCY=1

# UUID du compte systeme cote stream_backend (users.id, cree une seule fois,
# email ai-moderation@gofolyx.internal) utilise comme reporter_id pour les
# Report crees automatiquement par la moderation IA. Pas un secret, mais
# specifique a chaque environnement (l'UUID differe en dev/prod).
AI_MODERATION_REPORTER_ID=<UUID_DU_COMPTE_SYSTEME>
