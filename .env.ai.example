# Variables PROPRES a ai_service — sans secrets. Pour DATABASE_URL/RABBITMQ_URL/
# REDIS_URL, ne pas dupliquer ici : en deploiement Docker (docker-compose.yml),
# ils sont injectes via `env_file: ../../stream_backend/.env` (le vrai fichier sur
# le VPS, dans /opt/backend-stack/.env — jamais copie ni commit dans ce repo).

TEXT_MODEL_PATH=./models/qwen3-1.7b-instruct-q4_k_m.gguf
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
YOLO_MODEL_PATH=./models/yolov11n.pt
WHISPER_MODEL_SIZE=base

MAX_RAM_MB_FOR_MODELS=2500
AI_QUEUE_CONCURRENCY=1
