# Variables PROPRES a ai_service. RABBITMQ_URL est reutilise tel quel depuis
# /opt/backend-stack/.env (meme format cote backend et cote asyncpg/amqp,
# aucune correction necessaire). En revanche DATABASE_URL et REDIS_URL DOIVENT
# etre re-declares ici pour ecraser la valeur du backend (docker-compose.yml
# charge /opt/backend-stack/.env PUIS .env.ai — la derniere valeur d'une meme
# cle gagne) :
#
# - DATABASE_URL cote backend = format SQLAlchemy
#   `postgresql+asyncpg://user:pass@postgres:5432/db?prepared_statement_cache_size=0`
#   incomprehensible par asyncpg.connect() (ai_service). Reprendre les memes
#   user/password/host/db que le backend, juste sans le prefixe "+asyncpg" ni
#   le query param.
# - REDIS_URL cote backend utilise la DB 0. ai_service utilise la DB 2 pour
#   ne jamais collisionner avec le cache/broker du backend (meme instance
#   Redis, index logique different) — reprendre le meme password que le
#   backend, changer uniquement le numero de DB en fin d'URL.
#
# Remplacer <PASSWORD> ci-dessous par la vraie valeur UNIQUEMENT dans le
# fichier .env.ai reel sur le serveur (non commit) — jamais ici.
DATABASE_URL=postgresql://stream:<PASSWORD>@postgres:5432/streaming
REDIS_URL=redis://:<PASSWORD>@redis:6379/2

TEXT_MODEL_PATH=./models/qwen3-1.7b-instruct-q4_k_m.gguf
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
YOLO_MODEL_PATH=./models/yolov11n.pt
WHISPER_MODEL_SIZE=base

MAX_RAM_MB_FOR_MODELS=2500
AI_QUEUE_CONCURRENCY=1
