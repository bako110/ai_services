# Fichier pour DEV LOCAL SANS DOCKER uniquement (test rapide sur un poste de dev).
# Sur le VPS, ai_service tourne en conteneur sur le reseau `stream_net` et recoit
# DATABASE_URL/RABBITMQ_URL/REDIS_URL via env_file depuis le vrai .env de
# stream_backend (voir docker-compose.yml) — ne jamais dupliquer ces secrets ici.
#
# Redis et RabbitMQ sont proteges par mot de passe en prod (voir
# stream_backend/docker-compose.prod.yml) — remplacer <PASSWORD> ci-dessous par
# les vraies valeurs UNIQUEMENT dans un .env local non commit, jamais dans ce
# fichier .env.example.

# ATTENTION format DATABASE_URL : DSN direct asyncpg (postgresql://...), PAS le
# format SQLAlchemy `postgresql+asyncpg://...?prepared_statement_cache_size=0`
# utilise par stream_backend/app/config.py — asyncpg.connect() ne comprend ni
# le prefixe "+asyncpg" ni ce query param.
DATABASE_URL=postgresql://stream:<PASSWORD>@localhost:5432/streaming

RABBITMQ_URL=amqp://stream:<PASSWORD>@localhost:5672/stream_vhost
REDIS_URL=redis://:<PASSWORD>@localhost:6379/2

# Chemins des modeles locaux (telecharges hors repo, pas commit) — voir aussi .env.ai.example
TEXT_MODEL_PATH=./models/qwen3-1.7b-instruct-q4_k_m.gguf
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
YOLO_MODEL_PATH=./models/yolov11n.pt
WHISPER_MODEL_SIZE=base

MAX_RAM_MB_FOR_MODELS=2500
AI_QUEUE_CONCURRENCY=1

# UUID du compte systeme cote stream_backend (users.id), reporter_id des
# Report crees automatiquement par la moderation IA.
AI_MODERATION_REPORTER_ID=<UUID_DU_COMPTE_SYSTEME>
